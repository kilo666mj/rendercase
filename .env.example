# Copy this file to .env and replace every example value.
RENDERCASE_PUBLIC_URL=https://rendercase.example.com
RENDERCASE_CONTENT_URL=https://content.rendercase.example.com
RENDERCASE_COOKIE_SECRET=replace-with-output-of-openssl-rand-base64-32
RENDERCASE_AUTH_MODE=oidc
RENDERCASE_OIDC_ISSUER=https://id.example.com
RENDERCASE_OIDC_CLIENT_ID=rendercase
RENDERCASE_OIDC_CLIENT_SECRET=replace-me
RENDERCASE_OIDC_REDIRECT_URL=https://rendercase.example.com/api/v1/auth/oidc/callback
RENDERCASE_ADMIN_SUBJECTS=replace-with-your-oidc-subject
RENDERCASE_ADMIN_GROUPS=
RENDERCASE_OAUTH_AUDIENCE=https://rendercase.example.com/mcp
RENDERCASE_TRUSTED_PROXIES=

# Alternative browser authentication through Cloudflare Access. Keep the OIDC
# issuer and OAuth audience above for MCP bearer-token authentication.
# RENDERCASE_AUTH_MODE=cloudflare_access
# RENDERCASE_CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# RENDERCASE_CF_ACCESS_AUD=replace-with-the-access-application-aud-tag

# Used by Docker Compose. Choose a long random value.
POSTGRES_PASSWORD=replace-me
